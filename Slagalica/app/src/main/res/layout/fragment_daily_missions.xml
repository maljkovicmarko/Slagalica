<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ImageButton
        android:id="@+id/menuButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/menu"
        android:scaleType="fitCenter"
        android:src="@drawable/menu_icon" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/daily_missions_title"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/dailyMissionsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/daily_missions_loading"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/dailyMissionsProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/daily_missions_progress_placeholder"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <ProgressBar
                android:id="@+id/dailyMissionsProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="3"
                android:progress="0"
                android:layout_marginBottom="20dp" />

            <LinearLayout
                android:id="@+id/dailyMissionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/dailyMissionsBonus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="18dp"
                android:text="@string/daily_missions_bonus_pending_placeholder"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="#FFF8E1" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
