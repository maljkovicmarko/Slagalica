<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp">

    <ImageView
        android:id="@+id/rewardIcon"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:contentDescription="@string/leaderboard_reward_icon_description"
        android:scaleType="centerInside"
        android:src="@drawable/star" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/leaderboard_reward_title"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rewardCycleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/rewardRankText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rewardTokensText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#C88900"
        android:textSize="22sp"
        android:textStyle="bold" />

</LinearLayout>
